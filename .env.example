# ====================================================================
# Frankfurt Signals EMEA Hackathon 2026 - Environment Configuration
# ====================================================================

# Signals Notebook Sandbox Configuration
SIGNALS_BASE_URL=https://hackathon.signalsnotebook.revvitycloud.com/api/rest/v1.0
SIGNALS_API_KEY=your-signals-api-key-here

# AI Copilot / LLM Configuration
# Option A (Standard): Put your Google Gemini key here (from Google AI Studio):
GEMINI_API_KEY=your-google-gemini-api-key-here
AI_MODEL=gemini-3.6-flash

# Option B (Hackathon Gateway): If using the central LiteLLM proxy instead, uncomment:
# AI_GATEWAY_URL=https://signals-ai.revvity-hackathon.com/v1
# AI_GATEWAY_KEY=your-team-gateway-key-here

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Set MOCK_MODE=true to simulate Signals & AI APIs without live credentials
MOCK_MODE=false
