# Copy to .env (never commit it), or set these as Codespaces secrets.
# Tip: put all lines into ONE Codespaces secret named HACKATHON and they are loaded automatically.

# --- Signals (from your team sheet) ---
SIGNALS_BASE_URL=https://<your-tenant>/api/rest/v1.0
SIGNALS_API_KEY=your-signals-api-key
# Optional: a sample template (sample:...) for creating samples
SIGNALS_SAMPLE_TEMPLATE_EID=

# --- AI (either Gemini or the hackathon gateway) ---
GEMINI_API_KEY=your-gemini-api-key
# AI_GATEWAY_URL=https://<gateway-host>/v1
# AI_GATEWAY_KEY=your-team-gateway-key
AI_MODEL=gemini-3.5-flash

# true = offline sample data everywhere (also automatic when a key is missing)
MOCK_MODE=false
