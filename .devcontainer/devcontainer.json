{
  "name": "Signals EMEA Hackathon 2026 Starter",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "Continue.continue"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.useEnvFile": true
      }
    }
  },
  "forwardPorts": [
    8000,
    8501
  ],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI app + API docs (/docs)",
      "visibility": "public",
      "onAutoForward": "openBrowser"
    },
    "8501": {
      "label": "Streamlit app",
      "visibility": "public",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r backend/requirements.txt && chmod +x scripts/*.sh && python scripts/setup_continue.py || true",
  "postStartCommand": "bash scripts/start.sh all"
}
